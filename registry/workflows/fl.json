  "flows": [
    {
      "id": "fl-noncontract",
      "title": "Non-contract fulfilment: PR → PO → delivery → FRN → invoice → payment",
      "verification": "execution",
      "notes": "Chain run 2026-11-16 (PR260000000004860 → PO260000000007002 → DO 01309H005M2600503 → FN260000000005402 → SD260000000002402 → invoice → DN260000000004401). Starts from an approved RN (after dp-add-to-cart, or --input RN=…). If the PO shows Pending Partial Fulfilment, use fl-noncontract-partial-debit-note from KAT-049.",
      "steps": [
        "KAT-046",
        "KAT-047",
        {
          "gate": "PO_LOOKUP"
        },
        "KAT-048",
        "KAT-049",
        {
          "gate": "DO_LOOKUP"
        },
        "KAT-050",
        "KAT-051",
        "KAT-054",
        "KAT-055"
      ]
    },
    {
      "id": "fl-noncontract-partial-debit-note",
      "title": "Non-contract, partial delivery above the order: stop delivery, invoice, debit note approval",
      "verification": "execution",
      "notes": "Memory debit-credit-note-procedure (verified 2026-11-16): services PO, delivery amount above the ordered amount; give --input PO=… of an acknowledged services PO.",
      "steps": [
        "KAT-049",
        {
          "gate": "DO_LOOKUP"
        },
        "KAT-050",
        "KAT-051",
        "KAT-052",
        "KAT-053",
        "KAT-054",
        "KAT-056"
      ]
    },
    {
      "id": "fl-contract",
      "title": "Contract fulfilment: CR → CO → delivery → FRN → invoice → payment",
      "verification": "execution",
      "notes": "Chain 2026-10-30..11-02: CR260000000005449 → CO260000000005848 → DO 01400K003S2600002 → FN260000000005203 → IN-CO… → payment. Needs the LA of a contract with approved FD and agreement (ct-fd-agreement).",
      "steps": [
        {
          "gate": "CT_LOOKUP"
        },
        "KAT-057",
        "KAT-058",
        {
          "gate": "CO_LOOKUP"
        },
        "KAT-059",
        "KAT-060",
        {
          "gate": "DO_LOOKUP"
        },
        "KAT-061",
        "KAT-062",
        "KAT-063",
        "KAT-064"
      ]
    }
