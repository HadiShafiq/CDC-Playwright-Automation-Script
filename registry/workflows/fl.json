      "outputs": [
        {
          "doc": "PR",
          "message": "is successfully submitted"
        }
      ],
      "checkpoint": {
        "id": "PR_SUBMITTED",
        "description": "Purchase Request submitted",
        "displayedStatus": {
          "en": null,
          "bm": null
        },
        "verification": "source",
        "evidence": "KAT-046 waits for 'is successfully submitted.'; Submit PR task appears a few minutes after RN approval; passed SIT 2026-11-16_112140"
